# --- Application ---
# Nom de l'application
APP_NAME=UniConnect
# Environnement (local, production)
APP_ENV=local
# Clé de chiffrement Laravel (générer avec : php artisan key:generate)
APP_KEY=
# Mode debug (true en local uniquement)
APP_DEBUG=true
# URL du backend
APP_URL=http://localhost:8000
# Version de l'API (exposée par GET /api/health)
APP_VERSION=1.0.0
# URL du frontend (CORS et liens dans les emails)
FRONTEND_URL=https://uniconnect-six-lake.vercel.app

# --- Base de données (PostgreSQL via Docker) ---
# Pilote de base de données
DB_CONNECTION=pgsql
# Hôte de la base
DB_HOST=127.0.0.1
# Port PostgreSQL
DB_PORT=5432
# Nom de la base
DB_DATABASE=uniconnect
# Utilisateur de la base
DB_USERNAME=uniconnect
# Mot de passe (doit correspondre à docker-compose.yml)
DB_PASSWORD=secret

# --- Mail (Mailpit via Docker) ---
# Pilote d'envoi : smtp vers Mailpit
MAIL_MAILER=smtp
# Hôte SMTP de Mailpit
MAIL_HOST=127.0.0.1
# Port SMTP de Mailpit
MAIL_PORT=1025
# Pas d'authentification en local
MAIL_USERNAME=null
# Pas d'authentification en local
MAIL_PASSWORD=null
# Pas de chiffrement en local
MAIL_ENCRYPTION=null
# Adresse d'expéditeur
MAIL_FROM_ADDRESS="no-reply@uniconnect.local"
# Nom d'expéditeur
MAIL_FROM_NAME="${APP_NAME}"

# --- Session / Cache / Queue ---
# Stockage des sessions
SESSION_DRIVER=database
# Pilote de cache
CACHE_STORE=database
# Pilote de file d'attente
QUEUE_CONNECTION=database

# --- IA gratuite (LLM) ---
# Fournisseur utilisé : gemini ou groq
LLM_PROVIDER=gemini
# Clé API Google Gemini (https://aistudio.google.com/apikey, ne jamais la commiter)
GEMINI_API_KEY=
# Modèle Gemini gratuit : gemini-3.5-flash-lite (15 requêtes/min, 500/jour ; les modèles « Flash » sont limités à 20/jour)
GEMINI_MODEL=gemini-3.5-flash-lite
# Clé API Groq (https://console.groq.com, ne jamais la commiter)
GROQ_API_KEY=
# Modèle Groq de secours (1 000 requêtes/jour, 8 000 tokens/min ; llama-3.3-70b-versatile n'existe plus)
GROQ_MODEL=openai/gpt-oss-120b