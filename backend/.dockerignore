# Contexte de build minimal : les dépendances sont installées dans l'image.
.git
.gitignore
.github
.env
.env.*
!.env.example
vendor
node_modules
public/build
public/hot
public/storage
storage/app/public
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore
bootstrap/cache/*
!bootstrap/cache/.gitignore
tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache
.DS_Store
Thumbs.db
*.log
