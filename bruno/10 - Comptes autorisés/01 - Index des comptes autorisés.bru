meta {
  name: 01 - Index des comptes autorisés
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/comptes-autorises?page=1&par_page=20
  body: none
  auth: inherit
}

tests {
  test("200 avec une liste paginée à 20 par page", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta.par_page).to.equal(20);
    expect(res.body.meta.total).to.be.a("number");
  });
}
