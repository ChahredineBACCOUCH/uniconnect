meta {
  name: 03 - Modifier un compte autorisé
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admin/comptes-autorises/{{compteId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Compte Bruno modifié"
  }
}

tests {
  test("200 et nom modifié", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.nom).to.equal("Compte Bruno modifié");
  });
}
