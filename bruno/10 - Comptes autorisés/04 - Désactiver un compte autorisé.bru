meta {
  name: 04 - Désactiver un compte autorisé
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/comptes-autorises/{{compteId}}/desactiver
  body: none
  auth: inherit
}

tests {
  test("200 et état DESACTIVE", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.etat).to.equal("DESACTIVE");
  });
}
