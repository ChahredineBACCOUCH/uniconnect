# URL de l'API backend Laravel
VITE_API_URL=http://localhost:8000/api

# Développement uniquement : true = ouvrir toutes les pages sans se connecter
# (utile tant que la connexion SCRUM-69/70 n'est pas terminée). Ignoré en production.
VITE_SANS_CONNEXION=false

# Développement uniquement : true = réponses simulées de l'Assistant IA (src/api/iaSimulation.js)
# tant que l'API /espaces/{id}/ia/questions n'existe pas (SCRUM-100/102). Ignoré en production.
VITE_IA_SIMULATION=false