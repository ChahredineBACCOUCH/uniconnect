meta {
  name: 02 - Envoyer un message
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/espaces/{{espaceId}}/messages
  body: json
  auth: bearer
}

body:json {
  {
    "contenu": "Bonjour a tous !"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("messageId", res.body.id);
  }
}

tests {
  test("201", function () {
    expect(res.status).to.equal(201);
  });
}
